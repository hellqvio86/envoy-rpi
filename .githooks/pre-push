#!/usr/bin/env bash
set -Eeuo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

echo "🔍 [pre-push] Running yamllint..."
yamllint .

echo "🔍 [pre-push] Running shellcheck..."
shellcheck -s bash bin/resolve-build-inputs.sh bin/publish.sh bin/renovate/run.sh bin/install-hooks.sh .githooks/pre-push tests/test_helpers.sh

echo "🧪 [pre-push] Running offline unit tests..."
./tests/test_helpers.sh

echo "🐳 [pre-push] Linting Dockerfile with hadolint..."
if command -v hadolint >/dev/null 2>&1; then
  hadolint Dockerfile
else
  docker run --rm -i ghcr.io/hadolint/hadolint < Dockerfile
fi

echo "🔐 [pre-push] Running TruffleHog secret scan..."
if command -v trufflehog >/dev/null 2>&1; then
  trufflehog --no-update git "file://${REPO_ROOT}" --only-verified --fail
  trufflehog --no-update filesystem "${REPO_ROOT}" --only-verified --fail
else
  SELINUX_ARGS=()
  if [[ -n "${CONTAINER_SELINUX_OPT:-}" ]]; then
    read -ra SELINUX_ARGS <<< "${CONTAINER_SELINUX_OPT}"
  fi
  docker run --rm "${SELINUX_ARGS[@]}" -e GIT_CONFIG_COUNT=1 -e GIT_CONFIG_KEY_0=safe.directory -e GIT_CONFIG_VALUE_0='*' -v "${REPO_ROOT}:/src:ro" -w /src trufflesecurity/trufflehog:latest git file:///src --only-verified --fail
  docker run --rm "${SELINUX_ARGS[@]}" -v "${REPO_ROOT}:/src:ro" -w /src trufflesecurity/trufflehog:latest filesystem /src --only-verified --fail
fi

if [[ "${PRE_PUSH_BUILD:-0}" == "1" ]]; then
  echo "🏗️ [pre-push] Building envoy-rpi locally..."
  make build
  echo "🧪 [pre-push] Running hardened runtime smoke test..."
  make smoke-test
else
  echo "ℹ️ [pre-push] Skipping full C++ Docker build (set PRE_PUSH_BUILD=1 or run 'make build' to run locally)."
fi

echo "✅ [pre-push] All lint, unit test, and secret scan checks passed!"
